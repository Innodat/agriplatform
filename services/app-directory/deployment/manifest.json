{
  "id": "directory",
  "depends_on": [
    "access"
  ],
  "dockerfile": "services/app-directory/deployment/Dockerfile",
  "env_file": "directory.env",
  "health_path": "/health",
  "public": {
    "prefix": "/directory",
    "paths": [
      "/api/v2/me/apps",
      "/api/me/apps",
      "/api/me/context"
    ],
    "methods": [
      "GET",
      "OPTIONS"
    ]
  },
  "required_env": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "APP_ENV",
    "CORS_ORIGINS",
    "APP_URL_PTS",
    "APP_URL_SCRIBESWELL",
    "ACCESS_URL",
    "DIRECTORY_SERVICE_KEY"
  ],
  "smoke_env": {
    "SUPABASE_URL": "https://fixture.supabase.co",
    "SUPABASE_ANON_KEY": "fixture-public",
    "APP_ENV": "production",
    "CORS_ORIGINS": "[\"https://fixture.test\"]",
    "APP_URL_PTS": "https://fixture.test",
    "APP_URL_SCRIBESWELL": "https://fixture.test/scribeswell/",
    "ACCESS_URL": "http://access:8000",
    "DIRECTORY_SERVICE_KEY": "fixture-directory-service-key"
  },
  "smoke_artifacts": []
}
