# Copy to external per-environment secret directory as directory.env; never commit real values.
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=REQUIRED_PUBLIC_KEY
# Only for projects issuing legacy HS256 tokens; omit for asymmetric signing.
# SUPABASE_JWT_SECRET=<actual legacy project signing secret>
APP_ENV=production
CORS_ORIGINS=["https://STAGING_SITE"]
APP_URL_PTS=https://STAGING_SITE
APP_URL_SCRIBESWELL=https://STAGING_SITE/scribeswell/
