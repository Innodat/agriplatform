# Copy to external per-environment secret directory as access.env; never commit real values.
ACCESS_DATABASE_URL=REQUIRED_RESTRICTED_RUNTIME_POSTGRES_URL_WITH_SSL
# Same restricted access_runtime login; required with PTS or other canonical service keys.
CAPABILITY_ACCESS_DATABASE_URL=REQUIRED_RESTRICTED_ACCESS_RUNTIME_POSTGRES_URL_WITH_SSL
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=REQUIRED_PUBLIC_KEY
PTS_SERVICE_KEY=REQUIRED_PTS_SERVICE_SECRET
CONTENT_SERVICE_KEY=REQUIRED_CONTENT_SERVICE_SECRET
# Required when Directory is included; use the same dedicated secret as directory.env.
DIRECTORY_SERVICE_KEY=REQUIRED_DIRECTORY_ONLY_KEY
# Optional retained actor display activation: omit ALL four entries to keep closed.
# Active key, fixed org and complete private connection are required together;
# previous key is optional and distinct during coordinated rotation. Never reuse keys.
# KDG_ACTOR_DISPLAY_SERVICE_KEY=REQUIRED_DEDICATED_DISPLAY_SECRET
# KDG_ACTOR_DISPLAY_PREVIOUS_SERVICE_KEY=OPTIONAL_DISTINCT_PREVIOUS_DISPLAY_SECRET
# KDG_ACTOR_DISPLAY_ORG_ID=REQUIRED_FIXED_ORGANIZATION_UUID
# IDENTITY_ACTOR_DISPLAY_DATABASE_URL=postgresql://identity_actor_display_runtime:REQUIRED_PRIVATE_PASSWORD@REQUIRED_EXPLICIT_HOST:5432/REQUIRED_DATABASE
