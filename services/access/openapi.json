{
  "components": {
    "schemas": {
      "AccountDecision": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "authorization_scope": {
            "$ref": "#/components/schemas/AccountScope"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "permission": {
            "const": "scribeswell.studies.use",
            "default": "scribeswell.studies.use",
            "title": "Permission",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "actor_id",
          "permission",
          "authorization_scope",
          "decision_id",
          "checked_at"
        ],
        "title": "AccountDecision",
        "type": "object"
      },
      "AccountScope": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "account",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "AccountScope",
        "type": "object"
      },
      "Check": {
        "properties": {
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "permission": {
            "title": "Permission",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "permission"
        ],
        "title": "Check",
        "type": "object"
      },
      "CheckError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "detail"
        ],
        "title": "CheckError",
        "type": "object"
      },
      "Decision": {
        "properties": {
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "actor_id"
        ],
        "title": "Decision",
        "type": "object"
      },
      "EnrollmentAck": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/EnrollmentResult"
          },
          "status": {
            "const": "committed",
            "default": "committed",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "status",
          "result"
        ],
        "title": "EnrollmentAck",
        "type": "object"
      },
      "EnrollmentResult": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "disposition": {
            "enum": [
              "created",
              "unchanged"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "permission": {
            "const": "scribeswell.studies.use",
            "default": "scribeswell.studies.use",
            "title": "Permission",
            "type": "string"
          }
        },
        "required": [
          "disposition",
          "account_id",
          "actor_id",
          "permission"
        ],
        "title": "EnrollmentResult",
        "type": "object"
      },
      "ErrorDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ErrorDetails",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrganizationDecision": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "authorization_scope": {
            "$ref": "#/components/schemas/OrganizationScope"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "membership_id": {
            "pattern": "^[1-9][0-9]{0,18}$",
            "title": "Membership Id",
            "type": "string"
          },
          "permission": {
            "title": "Permission",
            "type": "string"
          },
          "resource_scope": {
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/OrganizationScope",
                "own_account": "#/components/schemas/OwnAccountScope"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/OwnAccountScope"
              },
              {
                "$ref": "#/components/schemas/OrganizationScope"
              }
            ],
            "title": "Resource Scope"
          }
        },
        "required": [
          "account_id",
          "actor_id",
          "permission",
          "authorization_scope",
          "decision_id",
          "checked_at",
          "membership_id",
          "resource_scope"
        ],
        "title": "OrganizationDecision",
        "type": "object"
      },
      "OrganizationScope": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "organization",
            "title": "Kind",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "org_id"
        ],
        "title": "OrganizationScope",
        "type": "object"
      },
      "OwnAccountScope": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "kind": {
            "const": "own_account",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "account_id"
        ],
        "title": "OwnAccountScope",
        "type": "object"
      },
      "StudiesError": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "title": "Details",
            "type": "null"
          },
          "error": {
            "const": "Request could not be completed",
            "default": "Request could not be completed",
            "title": "Error",
            "type": "string"
          },
          "error_id": {
            "enum": [
              "authentication_required",
              "service_access_denied",
              "access_denied",
              "identity.verification_required",
              "validation_failed",
              "authorization_unavailable",
              "identity.setup_unavailable",
              "dependency_unavailable"
            ],
            "title": "Error Id",
            "type": "string"
          }
        },
        "required": [
          "error_id",
          "error",
          "details"
        ],
        "title": "StudiesError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "KdgBearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "KdgServiceKey": {
        "in": "header",
        "name": "X-Service-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Shared current access",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/check": {
      "post": {
        "operationId": "check_v1_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Service-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Check"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check"
      }
    },
    "/v2/check": {
      "post": {
        "operationId": "check_v2_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Service-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "authorization_scope": {
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "organization",
                            "title": "Kind",
                            "type": "string"
                          },
                          "org_id": {
                            "format": "uuid",
                            "title": "Org Id",
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "org_id"
                        ],
                        "title": "OrganizationScope",
                        "type": "object"
                      },
                      "permission": {
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "Permission",
                        "type": "string"
                      }
                    },
                    "required": [
                      "permission",
                      "authorization_scope"
                    ],
                    "title": "OrganizationCheck",
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "authorization_scope": {
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "account",
                            "title": "Kind",
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "title": "AccountScope",
                        "type": "object"
                      },
                      "permission": {
                        "const": "scribeswell.studies.use",
                        "title": "Permission",
                        "type": "string"
                      }
                    },
                    "required": [
                      "permission",
                      "authorization_scope"
                    ],
                    "title": "AccountCheck",
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/OrganizationDecision"
                    },
                    {
                      "$ref": "#/components/schemas/AccountDecision"
                    }
                  ],
                  "title": "Response Check V2 Check Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CheckError"
                    },
                    {
                      "$ref": "#/components/schemas/StudiesError"
                    }
                  ],
                  "title": "Response 401 Check V2 Check Post"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CheckError"
                    },
                    {
                      "$ref": "#/components/schemas/StudiesError"
                    }
                  ],
                  "title": "Response 403 Check V2 Check Post"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CheckError"
                    },
                    {
                      "$ref": "#/components/schemas/StudiesError"
                    }
                  ],
                  "title": "Response 409 Check V2 Check Post"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CheckError"
                    },
                    {
                      "$ref": "#/components/schemas/StudiesError"
                    }
                  ],
                  "title": "Response 422 Check V2 Check Post"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CheckError"
                    },
                    {
                      "$ref": "#/components/schemas/StudiesError"
                    }
                  ],
                  "title": "Response 503 Check V2 Check Post"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "KdgBearer": [],
            "KdgServiceKey": []
          }
        ],
        "summary": "Check"
      }
    },
    "/v2/enrollments/scribeswell-studies": {
      "post": {
        "operationId": "enroll_v2_enrollments_scribeswell_studies_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Service-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "operation_id": {
                    "format": "uuid",
                    "title": "Operation Id",
                    "type": "string"
                  }
                },
                "required": [
                  "operation_id"
                ],
                "title": "Operation",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentAck"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudiesError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudiesError"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudiesError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudiesError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "KdgBearer": [],
            "KdgServiceKey": []
          }
        ],
        "summary": "Enroll"
      }
    }
  }
}
