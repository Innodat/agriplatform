{
  "components": {
    "schemas": {
      "Check": {
        "properties": {
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "permission": {
            "title": "Permission",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "permission"
        ],
        "title": "Check",
        "type": "object"
      },
      "CheckError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "detail"
        ],
        "title": "CheckError",
        "type": "object"
      },
      "Decision": {
        "properties": {
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "actor_id"
        ],
        "title": "Decision",
        "type": "object"
      },
      "ErrorDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ErrorDetails",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrganizationDecision": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "authorization_scope": {
            "$ref": "#/components/schemas/OrganizationScope"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "membership_id": {
            "pattern": "^[1-9][0-9]{0,18}$",
            "title": "Membership Id",
            "type": "string"
          },
          "permission": {
            "title": "Permission",
            "type": "string"
          },
          "resource_scope": {
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/OrganizationScope",
                "own_account": "#/components/schemas/OwnAccountScope"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/OwnAccountScope"
              },
              {
                "$ref": "#/components/schemas/OrganizationScope"
              }
            ],
            "title": "Resource Scope"
          }
        },
        "required": [
          "account_id",
          "actor_id",
          "permission",
          "authorization_scope",
          "decision_id",
          "checked_at",
          "membership_id",
          "resource_scope"
        ],
        "title": "OrganizationDecision",
        "type": "object"
      },
      "OrganizationScope": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "organization",
            "title": "Kind",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "org_id"
        ],
        "title": "OrganizationScope",
        "type": "object"
      },
      "OwnAccountScope": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "kind": {
            "const": "own_account",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "account_id"
        ],
        "title": "OwnAccountScope",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "KdgBearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "KdgServiceKey": {
        "in": "header",
        "name": "X-Service-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Shared current access",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/check": {
      "post": {
        "operationId": "check_v1_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Service-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Check"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check"
      }
    },
    "/v2/check": {
      "post": {
        "operationId": "check_v2_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Service-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "authorization_scope": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "organization",
                        "title": "Kind",
                        "type": "string"
                      },
                      "org_id": {
                        "format": "uuid",
                        "title": "Org Id",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "org_id"
                    ],
                    "title": "OrganizationScope",
                    "type": "object"
                  },
                  "permission": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Permission",
                    "type": "string"
                  }
                },
                "required": [
                  "permission",
                  "authorization_scope"
                ],
                "title": "OrganizationCheck",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationDecision"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckError"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "KdgBearer": [],
            "KdgServiceKey": []
          }
        ],
        "summary": "Check"
      }
    }
  }
}
