{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "paths": {
      "@platform/app-directory-client": [
        "../app-directory-client/src/index.ts"
      ]
    },
    "noEmit": true,
    "rootDir": ".."
  },
  "include": [
    "src"
  ]
}
