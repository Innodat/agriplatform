{
  "manifests": [
    "apps/pts/deployment/manifest.json",
    "apps/scribeswell/deployment/manifest.json",
    "services/access/deployment/manifest.json",
    "services/content-service/deployment/manifest.json",
    "services/app-directory/deployment/manifest.json"
  ],
  "migration_groups": [
    {
      "id": "pts-owned",
      "dockerfile": "apps/pts/deployment/Migrations.Dockerfile",
      "env_file": "pts-migrations.env",
      "owners": [
        "access",
        "content",
        "pts"
      ]
    },
    {
      "id": "scribeswell-owned",
      "dockerfile": "apps/scribeswell/deployment/Migrations.Dockerfile",
      "env_file": "scribeswell-migrations.env",
      "owners": ["scribeswell"],
      "compatibility_inputs": [
        "apps/scribeswell/deployment/migrate.py",
        "apps/scribeswell/deployment/migration-requirements.txt",
        "apps/scribeswell/backend/database.py",
        "platform/deployment/host-release.py",
        "platform/deployment/target_contract.py"
      ]
    }
  ],
  "bootstrap_paths": [
    "platform/supabase",
    "apps/scribeswell/supabase",
    "apps/scribeswell/deployment/bootstrap"
  ]
}
