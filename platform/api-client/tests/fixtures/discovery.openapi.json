{
  "openapi": "3.1.0",
  "info": {"title": "Scoped discovery contract fixture", "version": "1"},
  "paths": {
    "/contexts": {"get": {"operationId": "contexts", "responses": {"200": {"description": "Current context page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ContextPage"}}}}}}},
    "/entries": {"get": {"operationId": "entries", "responses": {"200": {"description": "Current entry observations", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Entries"}}}}}}}
  },
  "components": {"schemas": {
    "Context": {"type": "object", "additionalProperties": false, "required": ["id", "membership_id"], "properties": {"id": {"type": "string", "format": "uuid"}, "membership_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"}}},
    "ContextPage": {"type": "object", "additionalProperties": false, "required": ["contexts", "next_cursor"], "properties": {"contexts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Context"}}, "next_cursor": {"anyOf": [{"type": "string"}, {"type": "null"}]}}},
    "Entry": {"type": "object", "additionalProperties": false, "required": ["id", "eligible_scope_kinds"], "properties": {"id": {"type": "string"}, "eligible_scope_kinds": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": ["account", "organization"]}}}},
    "Entries": {"type": "object", "additionalProperties": false, "required": ["entries", "checked_at"], "properties": {"entries": {"type": "array", "items": {"$ref": "#/components/schemas/Entry"}}, "checked_at": {"type": "string", "format": "date-time"}}}
  }}
}
