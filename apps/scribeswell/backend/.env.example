# Server-only reader authority. Set the password outside version control.
SCRIBESWELL_DATABASE_URL=postgresql://scribeswell_runtime:REQUIRED_PASSWORD@127.0.0.1:54322/postgres
# Auth remains in Supabase; public Bible reading needs no signing secret.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWT_SECRET=<actual legacy HS256 signing secret, only when needed>
# Do not set SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
APP_ENV=development
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
