# Supplemental private inputs for studies_rollout.py, outside the repository.
# This is NOT the complete API/Access env: prepare preserves retained whole envs.
# All four owner DB URLs and the retained public URL use the SAME Supabase project.
SCRIBESWELL_STUDIES_DATABASE_URL=postgresql://scribeswell_studies_runtime:REQUIRED@db.PROJECT.supabase.co/postgres?sslmode=require
# Private Compose network only; never publish Access or its enrollment route.
SCRIBESWELL_STUDIES_ACCESS_URL=http://access:8000
SCRIBESWELL_STUDIES_SERVICE_KEY=REQUIRED_RESTRICTED_SCRIBESWELL_KEY
SCRIBESWELL_SERVICE_KEY=REQUIRED_RESTRICTED_SCRIBESWELL_KEY
STUDIES_ACCESS_DATABASE_URL=postgresql://access_studies_runtime:REQUIRED@db.PROJECT.supabase.co/postgres?sslmode=require
STUDIES_IDENTITY_DATABASE_URL=postgresql://identity_studies_reader_runtime:REQUIRED@db.PROJECT.supabase.co/postgres?sslmode=require
STUDIES_IDENTITY_SETUP_DATABASE_URL=postgresql://identity_studies_setup_runtime:REQUIRED@db.PROJECT.supabase.co/postgres?sslmode=require
