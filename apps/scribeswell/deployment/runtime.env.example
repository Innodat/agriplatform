# Copy to external per-environment secret directory as scribeswell.env; never commit real values.
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REQUIRED_SERVER_ONLY_SUPABASE_KEY
# Only for projects issuing legacy HS256 tokens; omit for asymmetric signing.
# SUPABASE_JWT_SECRET=<actual legacy project signing secret>
APP_ENV=production
CORS_ORIGINS=["https://STAGING_SITE"]
