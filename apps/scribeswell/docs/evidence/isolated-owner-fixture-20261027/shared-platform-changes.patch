+class ScribeswellNativeAcceptance(NativeAcceptance):
+    test_shared_local_readable_parent_allowed_writable_parent_refused = None
+
+    def setUp(self):
+        super().setUp()
+        schema = 'schema/scribeswell-development-target-v1.json'
+        source = ROOT / 'platform/deployment' / schema
+        if source.exists():
+            shutil.copyfile(source, self.root / 'platform/deployment' / schema)
+        self.target = json.loads((ROOT / 'platform/deployment/environments/scribeswell-local.json').read_text())
+        self.target['workspace_root'] = str(self.root)
+        self.target_path.write_text(json.dumps(self.target))
+        self.run = self.root / 'platform/deployment/.local/scribeswell' / self.run_id
+
+    def test_sequential_fresh_networks_are_removed_only_after_stop(self):
+        networks = {}
+        removed = []
+        stages = []
+        def docker(arguments, path, missing=False):
+            action = arguments[1]
+            if action == 'create':
+                self.assertFalse(networks, 'Prior subnet must have been released')
+                labels = {}
+                for index, argument in enumerate(arguments):
+                    if argument == '--label':
+                        key, value = arguments[index + 1].split('=', 1)
+                        labels[key] = value
+                networks[arguments[-1]] = dict(Name=arguments[-1], Driver='bridge',
+                    Id=('%064x' % (len(removed) + 1)), Labels=labels,
+                    Options={native_cli.BINDING: '127.0.0.1'},
+                    IPAM={'Config': [{'Subnet': self.target['docker_subnet']}]}, Containers={})
+                return b'created'
+            if action == 'inspect':
+                value = networks.get(arguments[-1])
+                return json.dumps(value).encode() if value else None
+            self.assertEqual(action, 'rm')
+            self.assertEqual(stages[-1], 'stop')
+            name, value = next(iter(networks.items()))
+            self.assertEqual(arguments[-1], value['Id'])
+            removed.append(value['Id'])
+            del networks[name]
+            return b'removed'
+        with patch.object(dev, 'ROOT', self.root), patch.object(native_cli, 'docker', side_effect=docker), \
+                patch.object(native_cli, 'docker_prerequisite'), \
+                patch.object(native_cli, 'vendor', side_effect=lambda executable, args, path, stage: stages.append(stage)):
+            for _ in range(2):
+                self.run_id = str(uuid.uuid4())
+                self.run = self.root / 'platform/deployment/.local/scribeswell' / self.run_id
+                native_cli.prepare(self.run, self.target, self.target_path.read_bytes(), self.run_id)
+                native_cli.network(self.target, self.run_id, True, self.run)
+                with contextlib.redirect_stdout(io.StringIO()):
+                    status = native_cli.main(['stop', '--target', str(self.target_path),
+                        '--run-id', self.run_id, '--supabase', str(self.vendor)])
+                self.assertEqual(status, 0)
+                self.assertFalse(networks)
+        self.assertEqual(len(set(removed)), 2)
+
+    def test_scribeswell_ancestor_permissions(self):
+        local = self.root / 'platform/deployment/.local'
+        local.mkdir(mode=0o755)
+        local.chmod(0o755)
+        self.assertEqual(self.invoke().returncode, 0)
+        self.assertEqual((local / 'scribeswell').stat().st_mode & 0o777, 0o700)
+        self.assertEqual(self.run.stat().st_mode & 0o777, 0o700)
+        for mode in (0o775, 0o777):
+            local.chmod(mode)
+            self.run_id = str(uuid.uuid4())
+            self.assertNotEqual(self.invoke().returncode, 0)
+            self.assertFalse((local / 'scribeswell' / self.run_id).exists())
+        local.chmod(0o755)
+        (local / 'scribeswell').chmod(0o755)
+        self.run_id = str(uuid.uuid4())
+        self.assertNotEqual(self.invoke().returncode, 0)
+        self.assertFalse((local / 'scribeswell' / self.run_id).exists())
+
+    def test_scribeswell_namespace_fixed_ports_and_configuration(self):
+        result = self.invoke()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertTrue((self.run / 'native.json').is_file())
+        self.assertFalse((self.run.parent.parent / 'kdg').exists())
+        self.assertFalse((self.run.parent.parent / 'leave').exists())
+        config = tomllib.loads((self.run / 'supabase/config.toml').read_text())
+        self.assertEqual(config['db']['port'], 55492)
+        self.assertEqual(config['api']['port'], 55491)
+        self.assertFalse(config['auth']['enable_signup'])
+        self.assertFalse(config['auth']['email']['enable_signup'])
+        self.assertEqual(len(dev.project_identity(self.target, self.run_id)), 39)
+        self.target['ports']['database'] = 55482
+        self.target_path.write_text(json.dumps(self.target))
+        self.assertNotEqual(self.invoke().returncode, 0)
+
