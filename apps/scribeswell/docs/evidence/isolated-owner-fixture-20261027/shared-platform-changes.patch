+        target = json.loads((ROOT / 'platform/deployment/environments/scribeswell-local.json').read_text())
+        run_id = str(uuid.uuid4())
+        project = dev.project_identity(target, run_id)
+        valid = dict(Name=project + '-network', Driver='bridge', Id='a'*64,
+            Options={native_cli.BINDING: '127.0.0.1'},
+            IPAM={'Config': [{'Subnet': target['docker_subnet']}]},
+            Labels={native_cli.LABEL_PREFIX + key: value for key, value in
+                dict(owner='platform/deployment', target=target['target_id'], run=run_id, project=project).items()})
+        with patch.object(native_cli, 'docker', side_effect=[None, b'created', json.dumps(valid).encode()]) as docker:
+            native_cli.network(target, run_id, True, ROOT)
+        create = docker.call_args_list[1].args[0]
+        self.assertEqual(create[create.index('--subnet') + 1], '10.254.27.0/24')
+        valid['Containers'] = {}
+        with patch.object(native_cli, 'docker', return_value=json.dumps(valid).encode()) as docker:
+            native_cli.remove_stopped_network(target, run_id, ROOT, valid['Id'])
+            self.assertEqual(docker.call_args.args[0], ['network', 'rm', valid['Id']])
+        for wrong in (dict(valid, Containers={'foreign': {}}),
+                      dict(valid, Containers=None),
+                      dict(valid, Id='b'*64),
+                      dict(valid, Options={native_cli.BINDING: '0.0.0.0'}),
+                      dict(valid, IPAM={'Config': [{'Subnet': '10.254.26.0/24'}]}),
+                      dict(valid, Labels={**valid['Labels'], native_cli.LABEL_PREFIX + 'target': 'kdg-local'})):
+            with patch.object(native_cli, 'docker', return_value=json.dumps(wrong).encode()):
+                with self.assertRaises(dev.Refusal) as failure:
+                    native_cli.remove_stopped_network(target, run_id, ROOT, valid['Id'])
+                self.assertIn(failure.exception.code, ('network_not_run_owned', 'network_not_empty'))
+                self.assertFalse(any(call.args[0][:2] == ['network', 'rm'] for call in native_cli.docker.call_args_list))
