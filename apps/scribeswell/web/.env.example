# apps/scribeswell/web — environment variables
# Copy to .env.local and fill in values

# Supabase (Auth only — data goes through FastAPI)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend URL (used by Vite proxy in dev; set for production builds)
VITE_API_BASE_URL=http://localhost:8000

# App Directory service URL (cross-app launcher)
VITE_APP_DIRECTORY_URL=http://localhost:8001

# Shared browser origin with PtS. Both apps must use the same Supabase project.
# Keep PtS at localhost:5179 to preserve its existing session.
VITE_APP_BASE=/scribeswell/
VITE_PLATFORM_ORIGIN=http://localhost:5179
# Use VITE_APP_BASE=/ and omit VITE_PLATFORM_ORIGIN only for isolated standalone development.
