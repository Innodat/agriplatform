  "info": {
    "title": "KDG candidate online audit metadata",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/captures/{capture_id}/events": {
      "get": {
        "description": "Current exact configured-organization read.all, verified account/durable actor/membership and exact organization resource scope before checkout; rechecked every page. Compact immutable create/changed-edit revision metadata only, without answers, definitions, receipts, outcome IDs or offline observation. Durable actor IDs are attribution rather than names or authority. Capture and revision stamps are independent statement times, not exact commit instants. One scoped SELECT with lateral limit+1, numeric revision DESC keyset, default30/max100, actual UTF8 <=64KiB. Closed canonical cursor binds account/org/capture/read.all/limit/last revision; navigation confers no authority. Refresh sees newer events; no cross-request snapshot promise. Empty continuation valid; first page without revision evidence unavailable. Unknown/duplicate query or nonempty body refused. All responses private/no-store; no activation or UI.",
        "operationId": "audit_events",
        "parameters": [
          {
            "in": "path",
            "name": "capture_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditError401"
                }
              }
            },
            "description": "Unauthorized",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditError403"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditError404"
                }
              }
            },
            "description": "Not Found",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditError409"
                }
              }
            },
            "description": "Conflict",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "422": {
