      "BooleanAnswer": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "value": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "details": {
                "maxLength": 5000,
                "pattern": "^[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
                "type": "string"
              },
