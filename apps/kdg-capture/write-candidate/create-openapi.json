      "CaptureReceipt": {
        "additionalProperties": false,
        "properties": {
          "command_type": {
            "const": "capture.create",
            "type": "string"
          },
          "command_version": {
            "const": 1,
            "maximum": 1.0,
            "minimum": 1.0,
            "title": "Command Version",
            "type": "integer"
          },
          "operation_id": {
            "format": "uuid",
            "maxLength": 36,
            "minLength": 36,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "title": "Operation Id",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/CaptureResult"
          },
          "status": {
            "const": "committed",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "command_type",
          "command_version",
          "status",
          "result"
        ],
        "title": "CaptureReceipt",
        "type": "object"
      },
