  "info": {
    "title": "KDG candidate operation recovery",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operations/{operation_id}": {
      "get": {
        "description": "Current own-read recovery. Exactly one command_type query item and one Bearer header; unknown or duplicate query items and nonempty bodies are refused. Unresolved is verified absence, not proof that an executing save cannot commit later.",
        "operationId": "recover_operation",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
              "type": "string"
            }
          },
          {
            "description": "Exactly one value; unknown and duplicate query items are rejected.",
            "in": "query",
            "name": "command_type",
            "required": true,
            "schema": {
              "enum": [
                "capture.create",
                "capture.edit"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CaptureReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/Unresolved"
                    }
                  ],
                  "title": "Response Recover Api V1 Operations  Operation Id  Get"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError401"
                }
              }
            },
            "description": "Unauthorized",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError403"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError409"
                }
              }
            },
            "description": "Conflict",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError422"
                }
              }
            },
            "description": "Unprocessable Content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError500"
                }
              }
            },
            "description": "Internal Server Error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryError503"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Recover"
      }
    }
  }
}
