  "info": {
    "title": "KDG candidate audit display composition",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/captures/{capture_id}/audit-details": {
      "get": {
        "description": "Current exact configured-organization read.all with verified account, durable actor, membership and matching organization resource scope before checkout. Returns the unchanged bounded audit page and a closed actor_display union. After the business transaction and connection are released, Identity receives only the sorted distinct owner, creator, modifier, included executor and non-null initiator IDs selected by that authorized page. Loaded labels preserve explicit per-ID unavailable results; invalid or unavailable Identity produces temporarily_unavailable for the entire label batch. A fresh final matching account/actor/membership/permission/organization-scope authorization is required before any aggregate publication, including label degradation. One original ten-second monotonic Budget covers input, read, lookup, final authority, owned unwind and serialization. Actual UTF8 limits: audit subtree64KiB, successful Identity input256KiB, error input1KiB and aggregate321KiB; no trimming, partial label batches or pagination changes. Numeric revision DESC keyset, default30/max100; closed canonical cursor binds account/org/capture/read.all/limit/last revision and supplies no authority. Current retained names are not event-time snapshots and grant no authority. No answers, definitions, receipts, account associations or offline observation. Unknown/duplicate query, nonempty body and browser service credentials refused. All responses private/no-store; no active mount or UI.",
        "operationId": "audit_details",
        "parameters": [
          {
            "in": "path",
            "name": "capture_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDetails"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDisplayError401"
                }
              }
            },
            "description": "Unauthorized",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDisplayError403"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDisplayError404"
                }
              }
            },
            "description": "Not Found",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDisplayError409"
                }
              }
            },
            "description": "Conflict",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditDisplayError422"
                }
              }
            },
            "description": "Unprocessable Content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              }
            }
          },
          "500": {
