            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "title": "Updated By",
            "type": "string"
          }
        },
        "required": [
          "capture_id",
          "org_id",
          "owner_account_id",
          "owner_actor_id",
          "child_id",
          "child_label",
          "questionnaire_id",
          "questionnaire_version_id",
          "questionnaire_version",
          "definition",
          "revision",
          "observation_date",
          "answers",
          "captured_at",
          "created_by",
