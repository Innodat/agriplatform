  "info": {
    "title": "KDG candidate protected own history",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/captures": {
      "get": {
        "description": "Current original-owner history with inclusive explicit observation dates, descending immutable (created_at,id) keyset position. Bounded canonical base64url JSON cursor binds current org/account/own-read/date/limit; untrusted navigation, neither signature nor authority. Every query independently constrains scope and dates. No snapshot, deletion evidence, write acknowledgement or offline observation renewal. Unknown/duplicate query and nonempty body refused. Maximum UTF8 page 2MiB; each original-definition detail 512KiB. Caller pins dates across pages.",
        "operationId": "history_captures",
        "parameters": [
          {
            "in": "query",
            "name": "from_date",
            "required": true,
            "schema": {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
              "title": "From Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to_date",
            "required": true,
            "schema": {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
              "title": "To Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryPage"
                }
              }
            },
