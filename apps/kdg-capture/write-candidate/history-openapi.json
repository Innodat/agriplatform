{
  "components": {
    "schemas": {
      "BooleanAnswer": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "value": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "details": {
                "maxLength": 5000,
                "pattern": "^[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
                "type": "string"
              },
              "value": {
                "const": true,
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        ],
        "title": "BooleanAnswer"
      },
      "BooleanQuestion": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "details_label": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "details_enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "details_label": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
                  "type": "string"
                }
              },
              "required": [
                "details_label"
              ]
            }
          }
        ],
        "properties": {
          "default": {
            "const": false,
            "title": "Default",
            "type": "boolean"
          },
          "details_enabled": {
            "title": "Details Enabled",
            "type": "boolean"
          },
          "details_label": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details Label"
          },
          "id": {
            "format": "uuid",
            "maxLength": 36,
            "minLength": 36,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
            "title": "Label",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "type": {
            "const": "boolean",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "required",
          "type",
          "default",
          "details_enabled"
        ],
        "title": "BooleanQuestion",
        "type": "object"
      },
      "CaptureDetail": {
