            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "child_id",
          "child_label",
          "child_revision",
          "child_eligibility_ref",
          "create_permission",
          "assignment",
          "checked_at",
          "expires_at"
        ],
        "title": "Child",
        "type": "object"
