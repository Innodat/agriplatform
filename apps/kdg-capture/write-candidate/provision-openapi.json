    "title": "KDG candidate protected setup",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/provision": {
      "get": {
        "description": "Selector-free current setup. Four independent current Access checks precede checkout. Positive slots retain exact decisions and seven-day observations; no grant is inferred from another. One original ten-second budget includes checkout, worker drain, commit, release and final serialization. Complete response <=1MiB and <=1000 children, no truncation. Opaque newly committed eligibility references grant no authority. State precedence: not_permitted, no_published_questionnaire, no_eligible_children, ready. No capture/history, local persistence or activation.",
        "operationId": "provision_setup",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provision"
                }
              }
            },
            "description": "Successful Response",
