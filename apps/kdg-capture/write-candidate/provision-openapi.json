{
  "components": {
    "schemas": {
      "Assignment": {
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "format": "uuid",
            "maxLength": 36,
            "minLength": 36,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "title": "Assignment Id",
            "type": "string"
          },
          "assignment_revision": {
            "pattern": "^(?:[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})(?![\\s\\S])",
            "title": "Assignment Revision",
            "type": "string"
          }
        },
        "required": [
          "assignment_id",
          "assignment_revision"
        ],
        "title": "Assignment",
        "type": "object"
      },
      "BooleanQuestion": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "details_label": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "details_enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "details_label": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
                  "type": "string"
                }
              },
              "required": [
                "details_label"
              ]
            }
          }
        ],
        "properties": {
          "default": {
            "const": false,
            "title": "Default",
            "type": "boolean"
          },
          "details_enabled": {
            "title": "Details Enabled",
            "type": "boolean"
          },
          "details_label": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details Label"
          },
          "id": {
            "format": "uuid",
            "maxLength": 36,
            "minLength": 36,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000\\ud800-\\udfff]*(?![\\s\\S])",
            "title": "Label",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "type": {
            "const": "boolean",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "required",
          "type",
          "default",
          "details_enabled"
        ],
        "title": "BooleanQuestion",
        "type": "object"
      },
      "Child": {
        "additionalProperties": false,
        "properties": {
          "assignment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Assignment"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])",
            "title": "Checked At",
            "type": "string"
          },
          "child_eligibility_ref": {
            "maxLength": 43,
            "minLength": 43,
