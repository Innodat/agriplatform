{
  "components": {
    "schemas": {
      "Context": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Account Id",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Actor Id",
            "type": "string"
          },
          "authorization_scope": {
            "$ref": "#/components/schemas/OrganizationScope"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Decision Id",
            "type": "string"
          },
          "membership_id": {
            "pattern": "^(?:[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$",
            "title": "Membership Id",
            "type": "string"
          },
          "permission": {
            "const": "kdg_capture.capture.read.own",
            "title": "Permission",
            "type": "string"
          },
          "resource_scope": {
            "$ref": "#/components/schemas/OwnAccountScope"
          }
        },
        "required": [
          "account_id",
          "actor_id",
          "membership_id",
          "authorization_scope",
          "resource_scope",
          "permission",
          "decision_id",
          "checked_at"
        ],
        "title": "Context",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "error_id": {
            "title": "Error Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "error_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "OrganizationScope": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "organization",
            "title": "Kind",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "org_id"
        ],
        "title": "OrganizationScope",
        "type": "object"
      },
      "OwnAccountScope": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Account Id",
            "type": "string"
          },
          "kind": {
            "const": "own_account",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "account_id"
        ],
        "title": "OwnAccountScope",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "KDG Capture context API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/context": {
      "get": {
        "operationId": "current_context",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Current Context"
      }
    }
  }
}
