{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@platform/app-directory-client": [
        "./../../../platform/app-directory-client/src/index.ts"
      ],
      "@platform/ui-business": [
        "./../../../platform/ui-business/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
