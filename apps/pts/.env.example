# These URLs all target the existing Supabase PostgreSQL project. No second production database.
# Provision each restricted LOGIN role explicitly; use TLS in hosted environments.
PTS_DATABASE_URL=postgresql+psycopg://pts_runtime:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
PTS_IMPORT_DATABASE_URL=postgresql+psycopg://pts_import:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
ACCESS_DATABASE_URL=postgresql+psycopg://access_runtime:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
CONTENT_DATABASE_URL=postgresql+psycopg://content_runtime:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
# Keep these three exclusively in the deployment process, never API/worker environments.
PTS_MIGRATION_DATABASE_URL=postgresql+psycopg://pts_migrator:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
ACCESS_MIGRATION_DATABASE_URL=postgresql+psycopg://access_migrator:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
CONTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://content_migrator:PASSWORD@SUPABASE_DB_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
ACCESS_URL=http://127.0.0.1:8011
CONTENT_URL=http://127.0.0.1:8012
PTS_SERVICE_KEY=GENERATE_A_DISTINCT_RANDOM_SECRET
CONTENT_SERVICE_KEY=GENERATE_ANOTHER_RANDOM_SECRET
PTS_IMPORT_SERVICE_KEY=GENERATE_A_THIRD_RANDOM_SECRET
PTS_IMPORT_ORG_ID=CONFIGURED_ORGANIZATION_UUID
CONTENT_BUCKET=pts-private
CONTENT_S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
CONTENT_S3_REGION=CONFIGURED_SUPABASE_REGION
CONTENT_S3_ACCESS_KEY=CONTENT_OWNER_ONLY
CONTENT_S3_SECRET_KEY=CONTENT_OWNER_ONLY
PTS_CORS_ORIGINS=http://localhost:5179
APP_URL_PTS=http://localhost:5179
